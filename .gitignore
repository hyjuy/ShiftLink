.env
*.gguf
.venv/
.test-deps/
.coverage
__pycache__/
*.pyc

# macOS Finder 폴더 설정
.DS_Store

# 로컬 에이전트 협업 문서 (커밋 안 함)
AGENTS.md
CLAUDE.md
AGENT_MEMORY.md

# 합성 데이터 산출물 (4.11 저장 원칙: 원본은 로컬/외부 관리, 코드만 git)
ledger/
artifacts/
splits/*
# 검토 가능한 출처·분할 계약 메타데이터만 공유한다. 원문·정답 산출물은 제외한다.
!splits/prototype_split.json
!splits/inventory.json
raw/
qc/report.json
data/*
!data/.gitkeep
mes_data/*
!mes_data/.gitkeep
seeds/*
!seeds/.gitkeep
!seeds/카드_작성_가이드_초안.md
!seeds/personas_v0.1.yaml
!seeds/source_registry.json

# 평가 하니스 실행 결과는 실행마다 생성되는 산출물 → 저장소에 누적하지 않는다.
# 보고에 인용할 실행 결과는 docs/reports/ 로 옮겨 근거와 함께 기록한다.
eval/results/*
!eval/results/.gitkeep

# graphify 지식그래프는 PC 로컬 산출물. 저장소에 올리지 않는다.
graphify-out/

# 제조사·민간 원문 PDF는 재배포 권한 미확인 → 로컬 보관, 공유 드라이브로 전달 (docs/sources/manual/download-status.md)
docs/sources/manual/bosch-*.pdf
docs/sources/manual/parker-*.pdf
docs/sources/manual/BR-*.pdf
# 사건·카드 원문 자료도 로컬에만 보관 (2026-09-30 회의 결정). README.md만 추적
docs/data/sources/**/*.pdf
# KOSHA 기술지침·법령 PDF도 로컬 보관 (9/30 결정: 원문 PDF는 저장소에 올리지 않음). 이미 추적 중인 M-101은 그대로
docs/sources/safety/*.pdf
docs/data/sources/**/*.html

# Aiven CA 등 인증서
*.pem

# Unity 3D 모델링 참고자료는 로컬 보관. 완성 모델·Prefab은 Assets/에서 관리한다.
/unity/ShiftLinkFactory/Assets/ReferenceMaterials/
/unity/ShiftLinkFactory/Assets/ReferenceMaterials.meta
