# 클라우드 DB (Aiven MySQL) — 실제 값은 .env에만 넣는다 (.env.example은 공개 저장소에 커밋됨)
# Aiven 콘솔 > Overview > Service URI를 그대로 붙여넣는다
# 형식: mysql://avnadmin:<password>@<service>-<project>.aivencloud.com:<port>/defaultdb?ssl-mode=REQUIRED
MYSQL_DATABASE_URL=
# Aiven 콘솔 > Overview > CA certificate 다운로드 경로 (예: C:/Users/<me>/.aiven/ca.pem). 커밋 금지
MYSQL_SSL_CA=
OLLAMA_HOST=
