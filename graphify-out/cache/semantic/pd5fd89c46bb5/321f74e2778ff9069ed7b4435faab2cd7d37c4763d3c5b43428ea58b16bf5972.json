{"nodes": [{"id": "docs_manual_br_damage_types_doc", "label": "SKF Bearing Damage and Failure Analysis", "file_type": "document", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_iso_15243", "label": "ISO 15243 (bearing failure modes classification)", "file_type": "document", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SKF and ISO 15243 failure mode classifications are identical; common terminology to communicate damage type and causes"}, {"id": "docs_manual_br_damage_types_rolling_contact_fatigue", "label": "Rolling contact fatigue (5.1)", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_wear", "label": "Wear (5.2)", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_corrosion", "label": "Corrosion (5.3)", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.50", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_electrical_erosion", "label": "Electrical erosion (5.4)", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_plastic_deformation", "label": "Plastic deformation (5.5)", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_cracking_fracture", "label": "Cracking and fracture (5.6)", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_subsurface_initiated_fatigue", "label": "Subsurface initiated fatigue", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated stress changes -> structural change -> subsurface microcracks at max shear depth 0.1-0.5 mm -> crack propagation -> spalling"}, {"id": "docs_manual_br_damage_types_surface_initiated_fatigue", "label": "Surface initiated fatigue", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asperity contact under mixed/boundary lubrication (inadequate lubrication, aggressive EP additives) -> surface microcracks -> microspalls"}, {"id": "docs_manual_br_damage_types_abrasive_wear", "label": "Abrasive wear", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Progressive material removal by contaminant particles; wear particles further reduce lubricant effectiveness"}, {"id": "docs_manual_br_damage_types_adhesive_wear", "label": "Adhesive wear (smearing / galling / scuffing)", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Material transfer from sliding under severe acceleration or too-light load; frictional heat tempers/rehardens surfaces causing cracking or spalling"}, {"id": "docs_manual_br_damage_types_moisture_corrosion", "label": "Moisture corrosion", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Water/aggressive liquid ingress (e.g., washdowns) -> greyish-black patches at rolling element spacing -> premature spalling; avoid via sealing and rust-inhibiting lubricant"}, {"id": "docs_manual_br_damage_types_fretting_corrosion", "label": "Fretting corrosion", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relative movement between ring and seat, usually too loose fit or form inaccuracies"}, {"id": "docs_manual_br_damage_types_false_brinelling", "label": "False brinelling", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Micromovements under vibration/oscillation at standstill form shallow depressions"}, {"id": "docs_manual_br_damage_types_excessive_current_erosion", "label": "Excessive current erosion", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_current_leakage_erosion", "label": "Current leakage erosion", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_overload_deformation", "label": "Overload deformation", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_indentation_from_particles", "label": "Indentation from particles (debris)", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Over-rolled hard contaminants create sharp-edged indentations that initiate surface fatigue"}, {"id": "docs_manual_br_damage_types_forced_fracture", "label": "Forced fracture", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_manual_br_damage_types_fatigue_fracture", "label": "Fatigue fracture", "file_type": "concept", "source_file": "docs/manual/BR-\uc190\uc0c1\uc720\ud615-093168a92d25cc46_pdf_preview_medium.pdf", "source_location": "p.60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_